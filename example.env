# 示例配置。真值在密匣 mixia：secrets/personal/common.env
# 本文件只是占位说明，不要往这里填真 key

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 三档模型。换模型只改这里，调用方代码不用动
OPENROUTER_MODEL_IMAGE=openai/gpt-image-2.5-sunburst
OPENROUTER_MODEL_TEXT=google/gemini-3.8-flash
OPENROUTER_MODEL_HEAVY=anthropic/claude-fable-5.1

# 日常档的思考强度：low / medium / high
# 思考无法关闭（enabled=false 上游返回 400 "Reasoning is mandatory"），
# 但 low 能让 reasoning_tokens 归零，实测同一问题成本便宜约 9.7 倍。
# 掌控档（heavy=True）不受这个值影响，要的就是深度推理。
OPENROUTER_REASONING_EFFORT=low
